# Copy to .env.local and add one key. Anthropic wins if both are set. Without a key the show still
# runs on the scripted lines in src/pieces/script.js.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional model override for the chosen provider.
# Defaults: Anthropic → claude-opus-5; OpenRouter → anthropic/claude-sonnet-5
LLM_MODEL=
# Anthropic path only: output_config.effort (low | medium | high). Default low: Pepe is quick.
LLM_EFFORT=
# Anthropic path only: set to 0 to turn off the server-side refusal fallback (on by default for Opus 5).
LLM_FALLBACKS=
